@model ESerranoEcoConnect.Models.ViewModels.PostDetailsViewModel



@{
    ViewBag.Title = "Post Details";
}
`
<h2>@Model.Title</h2>

<hr />

<dl class="dl-horizontal">

    <dt>Category</dt>
    <dd>@Model.CategoryName</dd>

    <dt>Author</dt>
    <dd>@Model.AuthorName</dd>

    <dt>Created</dt>
    <dd>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>

    <dt>Content</dt>
    <dd>@Model.Content</dd>

</dl>

<hr />

<h3>Comments</h3>

@if (Model.Comments != null && Model.Comments.Any())
{
    foreach (var c in Model.Comments)
    {
        <div style="margin-bottom:15px;">
            <p><strong>@c.Author.FirstName @c.Author.LastName</strong></p>
            <p>@c.Content</p>
            <p><i>@c.CreatedAt.ToString("dd/MM/yyyy HH:mm")</i></p>
        </div>
        <hr />
    }
}
else
{
    <p>No comments yet.</p>
}


<!-- added in stage 9 Members and Suspended members comments-->
@if (User.Identity.IsAuthenticated)
{
    <h4>Add a comment</h4>

    using (Html.BeginForm("CreateComment", "Comment", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.PostId)

        <div class="form-group">
            @Html.Label("Comment")
            @Html.TextArea("NewCommentContent",null, new {@class = "form-control", rows = 4})
        </div>

        <button type="submit" class="btn btn-primary">Submit Comment</button>
    }
}

<p>
    @Html.ActionLink("Back to Blogs", "GetBlogs", "Home", null, new { @class = "btn btn-default" })
 
</p>
