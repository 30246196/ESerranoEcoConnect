@model ESerranoEcoConnect.Models.Comment

@{
    ViewBag.Title = "DeleteMyComment";
}

<h2>Delete My Comment</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Comment</h4>
    <hr />
    <dl class="dl-horizontal">
     
        <dt>
            @Html.DisplayNameFor(model => model.Content)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Content)
        </dd>       

    </dl>

    @using (Html.BeginForm("DeleteMyCommentConfirmed","Comment", new { id = Model.CommentId},FormMethod.Post)) {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Delete" class="btn btn-danger" /> |
            @Html.ActionLink("Back to List", "Index","Comment",new {id = Model.PostId},new {@class = "btn btn-default"})
        </div>
    }
</div>
