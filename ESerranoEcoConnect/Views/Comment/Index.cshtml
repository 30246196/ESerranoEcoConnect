@model IEnumerable<ESerranoEcoConnect.Models.Comment>


@*<p>
        @Html.ActionLink("Create New Comment", "CreateComment")
    </p>*@
@{
    ViewBag.Title = "My Comments";
}

<h2>My Comments</h2>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<hr />
<table class="table">
    <tr>
        @*<th>
                @Html.DisplayNameFor(model => model.Author.FirstName)
            </th>*@
        <th>
            @Html.DisplayNameFor(model => model.Post.Category.CategoryName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Post.Title)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Content)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CreatedAt)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.UpdatedAt)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.IsFlagged)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            @*<td>
                    @Html.DisplayFor(modelItem => item.Author.FirstName)
                </td>*@
            <td>
                @Html.DisplayFor(modelItem => item.Post.Category.CategoryName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Post.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Content)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsFlagged)
            </td>
            <td>
                @Html.ActionLink("Edit", "EditMyComment", "Comment", new { id = item.CommentId }, null) |
                @*@Html.ActionLink("Details", "Details", "Comment", new { id = item.CommentId },null) |*@
                @Html.ActionLink("Delete", "DeleteMyComment", "Comment", new { id = item.CommentId }, new { @class = "btn btn-danger" })
            </td>
        </tr>
    }

</table>
