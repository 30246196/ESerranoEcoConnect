

@model IEnumerable<ESerranoEcoConnect.Models.Post>

@{
    ViewBag.Title = "My Posts";
}

<h2>My Posts</h2>

<p>
    <!-- @Html.ActionLink("Create New Post", "Create", "Post", null, new { @class = "btn btn-primary" }) -->
    @Html.ActionLink("Create New Post", "Create","Staff")
</p>

<table class="table">
    <tr>
        <th>Title</th>
        <th>Category</th>
        <th>Created</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.Category.CategoryName</td>
            <td>@item.CreatedAt.ToShortDateString()</td>
            <td>
                @Html.ActionLink("Edit", "Edit", "Staff", new { id = item.PostId }, null) |
                @Html.ActionLink("Details", "Details", "Staff", new { id = item.PostId }, null) |
                @Html.ActionLink("Delete", "Delete", "Staff", new { id = item.PostId }, null)
            </td>
        </tr>
    }
</table>

