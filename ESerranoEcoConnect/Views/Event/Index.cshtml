@model IEnumerable<ESerranoEcoConnect.Models.Event>

<h2>Upcoming Events</h2>

<table class="table table-striped">
    <tr>
        <th>Title</th>
        <th>Date</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.EventDate.ToShortDateString()</td>
            <td>
                <button class="btn btn-primary" onclick="eventAlert('@item.Title')">
                    Alert Task
                </button>
            </td>
        </tr>
    }
</table>

<div id="customModal" class="modal-overlay" style="display:none;">
    <div class="modal-box">
        <h3 id="modalTitle"></h3>
        <button onclick="closeModal()" class="btn btn-primary">OK</button>
    </div>
</div>

<style>
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .modal-box {
        background: white;
        padding: 20px 30px;
        border-radius: 8px;
        text-align: center;
        min-width: 300px;
    }
</style>


@*<script>
    function eventAlert(title) {
        alert("You clicked on event: " + title);
    }
</script>*@

<script>
    function eventAlert(title) {
        document.getElementById("modalTitle").innerText =
            "You clicked on event: " + title;

        document.getElementById("customModal").style.display = "flex";
    }

    function closeModal() {
        document.getElementById("customModal").style.display = "none";
    }
</script>

